    --rep:#B22234; --dem:#2E5AAC;
    --fs-0:0.8rem; --fs-1:0.92rem; --fs-2:1.05rem; --fs-3:1.35rem; --fs-4:1.9rem; --fs-5:2.6rem;
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--paper);color:var(--ink);font-family:"Source Sans 3","Segoe UI","Helvetica Neue",Arial,sans-serif;font-size:16px;line-height:1.4}
  body{display:flex;flex-direction:column;min-height:100vh}
  header{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1.1rem 1.4rem .6rem;border-bottom:1px solid var(--rule);flex-wrap:wrap}
  header h1{font-size:var(--fs-3);font-weight:600;margin:0;letter-spacing:-.01em}
  header p{margin:0;color:var(--ink-2);font-size:var(--fs-1)}
  .controls{display:flex;gap:1.2rem;align-items:center;flex-wrap:wrap;padding:.6rem 1.4rem;border-bottom:1px solid var(--rule)}
  .seg{display:inline-flex;border:1px solid var(--ink);border-radius:4px;overflow:hidden}
  .seg button{background:var(--paper);color:var(--ink);border:0;padding:.45rem .8rem;font:inherit;font-size:var(--fs-1);cursor:pointer;border-right:1px solid var(--ink)}
  .seg button:last-child{border-right:0}
