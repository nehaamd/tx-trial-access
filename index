<script>
(function(){
  const D = JSON.parse(document.getElementById('data').textContent);
  const C = D.counties, DI = D.districts, NCI = D.nci;
  const fmt = d3.format(','), pct = v => (Math.round(v*10)/10).toLocaleString(undefined,{maximumFractionDigits:1});
  const partyColor = p => p==='R' ? 'var(--rep)' : p==='D' ? 'var(--dem)' : 'var(--ink-3)';

  const METRICS = {
    t:  {label:'Recruiting trials with a site in the county', get:c=>c.t,
         classes:[['0 trials',0,1,'#F3E6E0'],['1–19',1,20,'#C9DCEE'],['20–99 (limited menu)',20,100,'#6BA3D6'],['100 or more (broad menu)',100,1e9,'#0B3C5D']]},
    mn: {label:'Road miles from the county population center to the nearest NCI-designated cancer center', get:c=>c.mn,
         classes:[['under 30 mi',0,30,'#0B3C5D'],['30–60 (about an hour)',30,60,'#3F7FB5'],['60–120',60,120,'#9EC4E0'],['120–200',120,200,'#F2C48A'],['200–300',200,300,'#D98B4A'],['300 or more',300,1e9,'#8A3B1E']]},
    mb: {label:'Road miles to the nearest county with 100 or more trials', get:c=>c.mb,
         classes:[['in a broad-menu county',0,1,'#0B3C5D'],['under 60 mi',1,60,'#3F7FB5'],['60–120',60,120,'#9EC4E0'],['120–200',120,200,'#F2C48A'],['200–300',200,300,'#D98B4A'],['300 or more',300,1e9,'#8A3B1E']]}
  };
  let metric = 't', selectedD = null, selectedC = null;
  const colorFor = (m, v) => { const k = METRICS[m].classes.find(k => v >= k[1] && v < k[2]); return k ? k[3] : '#ddd'; };

  // ---- map ----
  const svg = d3.select('#map'), W = 900, H = 820;
  const proj = d3.geoConicConformal().parallels([27.5, 35]).rotate([100, 0]);
  proj.fitExtent([[12, 12], [W - 12, H - 12]], D.geo.counties);
  const path = d3.geoPath(proj);
  const gC = svg.append('g'), gD = svg.append('g'), gS = svg.append('g'), gL = svg.append('g'), gN = svg.append('g');
  const tip = document.getElementById('tip'), wrap = document.getElementById('map-wrap');

  const counties = gC.selectAll('path').data(D.geo.counties.features).join('path')
    .attr('class', 'county').attr('d', path)
    .on('mousemove', (ev, f) => { const c = C[f.properties.id]; if (!c) return;
      tip.style.display = 'block'; const r = wrap.getBoundingClientRect();
      tip.style.left = (ev.clientX - r.left + 14) + 'px'; tip.style.top = (ev.clientY - r.top + 14) + 'px';
      tip.innerHTML = `<b>${c.n} County</b><br>${fmt(c.t)} eligible trial${c.t===1?'':'s'} · ${fmt(c.p)} residents 55+<br>${c.mn} road-mi to ${c.nn}<br>${c.mb ? c.mb + ' road-mi to a broad menu (' + c.nb + ')' : 'hosts a broad menu'}<br><span style="opacity:.75">District${c.d.length>1?'s':''} ${c.d.map(x=>'TX-'+x[0]).join(', ')}</span>`; })
    .on('mouseleave', () => tip.style.display = 'none')
    .on('click', (ev, f) => selectCounty(f.properties.id));

  const districts = gD.selectAll('path').data(D.geo.districts.features).join('path').attr('class', 'district').attr('d', path);
  const halo = gS.append('path').attr('class', 'district selected-halo').attr('d', null);
  const sel = gS.append('path').attr('class', 'district selected').attr('d', null);

  // district labels: only where the district is big enough on screen; metro districts are reachable from the list
  const labels = gL.selectAll('text').data(D.geo.districts.features.filter(f => path.area(f) > 900)).join('text')
    .attr('class', 'dlabel').attr('transform', f => `translate(${path.centroid(f)})`).attr('text-anchor', 'middle').attr('dy', '.35em')
    .text(f => f.properties.id).on('click', (ev, f) => selectDistrict(f.properties.id));

  const star = d3.symbol().type(d3.symbolStar).size(190);
  gN.selectAll('path').data(NCI).join('path').attr('class', 'nci').attr('d', star).attr('transform', n => `translate(${proj([n.lon, n.lat])})`);
  gN.selectAll('text').data(NCI.filter(n => n.st !== 'TX')).join('text').attr('class', 'ncilabel').attr('x', n => proj([n.lon, n.lat])[0]).attr('y', n => proj([n.lon, n.lat])[1] - 11).attr('text-anchor', 'middle').text(n => n.n);

  function paint() {
    counties.attr('fill', f => { const c = C[f.properties.id]; return c ? colorFor(metric, METRICS[metric].get(c)) : '#eee'; });
    const lg = d3.select('#legend'); lg.html('');
    lg.append('span').style('font-weight', '600').style('color', 'var(--ink)').text(METRICS[metric].label);
    METRICS[metric].classes.forEach(k => lg.append('span').html(`<i style="background:${k[3]}"></i>${k[0]}`));
  }
  document.querySelectorAll('.seg button').forEach(b => b.addEventListener('click', () => { metric = b.dataset.metric; document.querySelectorAll('.seg button').forEach(x => x.setAttribute('aria-pressed', x === b)); paint(); }));
  document.getElementById('lyr-d').addEventListener('change', e => gD.style('display', e.target.checked ? null : 'none'));
  document.getElementById('lyr-n').addEventListener('change', e => gN.style('display', e.target.checked ? null : 'none'));
  document.getElementById('lyr-l').addEventListener('change', e => gL.style('display', e.target.checked ? null : 'none'));

  // ---- finders ----
  const pickD = document.getElementById('pick-d');
  Object.keys(DI).sort((a, b) => +a - +b).forEach(k => { const o = document.createElement('option'); o.value = k; const d = DI[k]; o.textContent = `TX-${k} — ${d.member || 'vacant'}${d.party ? ' (' + d.party + ')' : ''}`; pickD.appendChild(o); });
  pickD.addEventListener('change', e => { if (e.target.value) selectDistrict(e.target.value); else clearSelection(); });
  const dl = document.getElementById('county-list'); Object.keys(C).sort((a, b) => C[a].n.localeCompare(C[b].n)).forEach(k => { const o = document.createElement('option'); o.value = C[k].n; dl.appendChild(o); });
  document.getElementById('pick-c').addEventListener('change', e => { const k = Object.keys(C).find(k => C[k].n.toLowerCase() === e.target.value.trim().toLowerCase()); if (k) selectCounty(k); });

  // ---- pane ----
  const pane = document.getElementById('pane-body');
  function statHTML(num, unit, text, hot) { return `<div class="stat${hot ? ' hot' : ''}"><div class="num">${num}<small>${unit}</small></div><p>${text}</p></div>`; }
  function renderState() {
    const s = D.meta.state;
    pane.innerHTML = `<p class="kicker">Texas, statewide</p><h2>${fmt(D.meta.trials)} recruiting trials</h2><p class="member">open to a 55-year-old, at sites in 39 of 254 counties</p>
      ${statHTML(pct(s.pct_lt20_trials_within_60rdmi), '%', 'of Texans 55+ have fewer than 20 trials within 60 road-miles of home; ' + pct(s.pct_zero_trials_within_60rdmi) + '% have none.', true)}
      ${statHTML(pct(s.pct_gt60rdmi_broad_menu), '%', 'live more than 60 road-miles from a county with 100 or more trials (Harris, Dallas, Bexar, Travis, Tarrant — or Oklahoma County for the Panhandle).', false)}
      ${statHTML(pct(s.pct_gt60rdmi_nci), '%', 'live more than 60 road-miles from any NCI-designated cancer center; the median Texan 55+ is ' + s.median_road_mi_nci + ' road-miles from one.', false)}
      <p class="note">Click a county on the map, or choose a district above. Districts are ranked 1–38 by combined access; the eight worst plus El Paso are the priority districts in the briefing packet.</p>`;
  }
  function selectDistrict(k) {
    selectedD = k; selectedC = null; pickD.value = k;
    const f = D.geo.districts.features.find(f => f.properties.id === k); halo.attr('d', path(f)); sel.attr('d', path(f));
    const inD = new Set(DI[k].counties); svg.classed('dim', true); counties.classed('in-district', f => inD.has(f.properties.id));
    const d = DI[k];
    const cos = d.cosponsor && d.cosponsor.startsWith('YES') ? 'cosponsor of H.R. 3521 (Republican lead)' : d.member ? 'not yet a cosponsor of H.R. 3521' : 'seat vacant';
    pane.innerHTML = `<p class="kicker">Congressional district, ${D.meta.plan}</p><h2>Texas ${ordinal(k)}</h2>
      <p class="member"><span class="dot" style="background:${partyColor(d.party)}"></span>${d.member || 'Vacant'}${d.party ? ' (' + d.party + ')' : ''} — ${cos}</p>
      <div class="chips"><span class="chip rank">Access rank ${d.rank} of 38</span><span class="chip">${fmt(d.p)} residents 55+</span></div><br>
      ${statHTML(pct(d.lt20), '%', 'of residents 55+ have fewer than 20 recruiting trials within 60 road-miles' + (d.z60 >= 1 ? ' (' + pct(d.z60) + '% have none).' : '.') + ' The typical resident can reach ' + fmt(d.t60) + ' trials within an hour’s drive.', d.lt20 >= 50)}
      ${statHTML(pct(d.g60b), '%', 'live more than 60 road-miles from a broad menu (a county with 100+ trials). For most residents the nearest is ' + d.broad + ' County, a median ' + fmt(d.medb) + ' road-miles away; ' + pct(d.g120b) + '% are more than 120 miles from one.', d.g60b >= 50)}
      ${statHTML(fmt(d.medn), ' mi', 'median road distance to the nearest NCI-designated cancer center, ' + d.nci + ' for most residents (about ' + (d.medn / 55).toFixed(1) + ' hours at highway speeds). ' + pct(d.g60n) + '% are more than 60 road-miles from any center.', d.medn >= 150)}
      <ul class="rows"><li><span>Trials within 60 road-miles (typical resident)</span><span>${fmt(d.t60)}</span></li><li><span>of which confirmed oral agents</span><span>${fmt(d.o60)}–${fmt(d.o60 + d.i60)}</span></li><li><span>Residents 55+ living in a county with no trial</span><span>${pct(d.zc)}%</span></li></ul>
      <p class="kicker" style="margin-top:1rem">Counties in the district</p><div class="chips">${d.counties.slice().sort((a, b) => C[b].t - C[a].t || C[a].n.localeCompare(C[b].n)).map(c => `<button type="button" class="chip" data-c="${c}">${C[c].n}${C[c].t ? ' · ' + C[c].t : ''}</button>`).join('')}</div>
      <p class="note">Population-weighted across census tracts; distances are shortest highway routes. Oral counts are a range because some trials list a drug without a route.</p>`;
    pane.querySelectorAll('.chip[data-c]').forEach(b => b.addEventListener('click', () => selectCounty(b.dataset.c)));
    pane.scrollTop = 0;
  }
  function selectCounty(k) {
    selectedC = k; const c = C[k];
    counties.classed('in-district', f => f.properties.id === k); svg.classed('dim', true); halo.attr('d', null); sel.attr('d', null); pickD.value = '';
    const menu = c.t >= 100 ? 'Hosts a broad menu (100+ trials).' : c.t >= 20 ? 'Hosts a limited menu (20–99 trials).' : c.t ? '' : 'No recruiting trial has a site here.';
    pane.innerHTML = `<p class="kicker">County</p><h2>${c.n}</h2><p class="member">${fmt(c.p)} residents 55+ · ${c.d.map(x => `<button type="button" class="chip" data-d="${x[0]}">TX-${x[0]}${c.d.length > 1 ? ' (' + Math.round(x[1] * 100) + '% of county area)' : ''}</button>`).join(' ')}</p>
      ${statHTML(fmt(c.t), c.t === 1 ? ' trial' : ' trials', 'with a recruiting site in the county, open to patients 55+. ' + menu + (c.t ? ' Confirmed oral-agent trials: ' + c.o + (c.i ? '–' + (c.o + c.i) : '') + '.' : ''), c.t === 0)}
      ${statHTML(fmt(c.mn), ' mi', 'by road from the county population center to the nearest NCI-designated center, ' + c.nn + ' (about ' + c.hn + ' h).', c.mn >= 150)}
      ${statHTML(c.mb ? fmt(c.mb) : '0', ' mi', c.mb ? 'to the nearest broad menu, ' + c.nb + ' (about ' + c.hb + ' h). Nearest limited menu (20+ trials): ' + (c.ml ? c.nl + ', ' + fmt(c.ml) + ' mi' : 'this county') + '.' : 'This county is itself a broad menu.', c.mb >= 120)}
      <p class="note">Distances follow Census primary and secondary roads from the 2020 population center; expect within about 10% of a mapping app. Trials counted once per county regardless of number of sites.</p>`;
    pane.querySelectorAll('.chip[data-d]').forEach(b => b.addEventListener('click', () => selectDistrict(b.dataset.d)));
    pane.scrollTop = 0;
  }
  function clearSelection() { selectedD = selectedC = null; svg.classed('dim', false); halo.attr('d', null); sel.attr('d', null); renderState(); }
  function ordinal(k) { const n = +k, s = (n % 100 >= 11 && n % 100 <= 13) ? 'th' : ({1: 'st', 2: 'nd', 3: 'rd'}[n % 10] || 'th'); return `${n}${s} District`; }
  svg.on('dblclick', clearSelection);

  document.getElementById('foot').innerHTML = `<p><strong>Data.</strong> ClinicalTrials.gov API v2, pulled ${D.meta.pull}: interventional studies, status Recruiting, primary purpose Treatment, oncology conditions, with a Texas site whose status is Recruiting or unreported; 35 non-oncology trials and 90 trials with a maximum enrollment age under 55 removed → ${fmt(D.meta.trials)} trials. Population 55+ from ACS 2023 5-year (B01001) by tract and county. Sites placed in counties by ZIP code. Road distances are shortest routes on Census TIGER primary/secondary roads (TX, NM, OK, LA, AR) from 2020 population centers; hours assume 55 mph. District values are population-weighted across census tracts using the Census tract–district relationship file; boundaries are the ${D.meta.plan}. Menu thresholds (20, 100) follow ASCO's 2024 county analysis. NCI-designated treating centers: MD Anderson and Baylor (Houston), UTSW (Dallas), UT Health Mays (San Antonio), UNM (Albuquerque), OU Stephenson (Oklahoma City).</p>
  <p><strong>Limits.</strong> Counts are of trials, not of trials a given patient is eligible for, and pool all cancer types. Registry status lags real enrollment. Oral classification is a text heuristic. Draft prepared as part of an NCCN Advocacy Academy project; re-pull before citing.</p>`;

  paint(); renderState();
})();
</script>
</body>
</html>
