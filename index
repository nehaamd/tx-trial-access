  #map-wrap{position:relative;padding:.6rem .8rem 1rem 1.2rem}
  svg{width:100%;height:auto;display:block}
  .county{stroke:#fff;stroke-width:.4;cursor:pointer;transition:opacity .15s}
  .county:hover{stroke:var(--ink);stroke-width:1.2}
  .dim .county:not(.in-district){opacity:.35}
  .district{fill:none;stroke:var(--ink);stroke-width:.9;pointer-events:none}
  .district.selected{stroke-width:3;stroke:var(--ink)}
  .district.selected-halo{stroke:#fff;stroke-width:6;opacity:.9}
  .dlabel{font-size:11px;font-weight:700;fill:var(--ink);paint-order:stroke;stroke:#fff;stroke-width:3px;cursor:pointer}
  .nci{fill:#F1C40F;stroke:#000;stroke-width:.7;pointer-events:none}
  .ncilabel{font-size:10px;fill:var(--ink);paint-order:stroke;stroke:#fff;stroke-width:3px;pointer-events:none}
  #tip{position:absolute;pointer-events:none;background:var(--ink);color:#fff;padding:.5rem .65rem;border-radius:4px;font-size:var(--fs-0);line-height:1.35;max-width:260px;display:none;z-index:5}
  #tip b{font-size:var(--fs-1)}
  aside{border-left:1px solid var(--rule);background:var(--panel);padding:1.1rem 1.4rem 1.4rem;overflow:auto}
  .finder{display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:1rem}
  .finder select,.finder input{font:inherit;font-size:var(--fs-1);padding:.4rem .5rem;border:1px solid var(--ink-3);border-radius:4px;background:#fff;color:var(--ink);min-width:0}
  .finder select{flex:1 1 220px}.finder input{flex:1 1 160px}
  .kicker{color:var(--ink-2);font-size:var(--fs-0);margin:0 0 .15rem}
  h2{font-size:var(--fs-4);font-weight:600;margin:0 0 .25rem;letter-spacing:-.015em;line-height:1.1}
  .member{margin:0 0 1rem;color:var(--ink-2);font-size:var(--fs-1)}
  .member .dot{display:inline-block;width:.6rem;height:.6rem;border-radius:50%;margin-right:.3rem;vertical-align:baseline}
  .stat{margin:0 0 .95rem;padding-left:.9rem;border-left:3px solid var(--rule)}
  .stat.hot{border-left-color:var(--rust)}
  .stat .num{font-size:var(--fs-5);font-weight:600;letter-spacing:-.02em;line-height:1;font-variant-numeric:tabular-nums}
  .stat .num small{font-size:var(--fs-2);font-weight:500;color:var(--ink-2);margin-left:.2rem}
  .stat p{margin:.2rem 0 0;color:var(--ink);font-size:var(--fs-1);max-width:34ch}
  .rows{margin:.6rem 0 0;padding:0;list-style:none;font-size:var(--fs-1)}
  .rows li{display:flex;justify-content:space-between;gap:1rem;padding:.35rem 0;border-top:1px solid var(--rule)}
  .rows li span:last-child{font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
  .chips{display:flex;flex-wrap:wrap;gap:.35rem;margin:.4rem 0 0}
  .chip{background:#fff;border:1px solid var(--ink-3);border-radius:999px;padding:.15rem .6rem;font:inherit;font-size:var(--fs-0);cursor:pointer;color:var(--ink)}
  .chip:hover{border-color:var(--ink)}
  .chip.rank{background:var(--ink);color:#fff;border-color:var(--ink)}
  .note{color:var(--ink-2);font-size:var(--fs-0);margin:1rem 0 0;max-width:60ch}
  footer{padding:.8rem 1.4rem 1.2rem;border-top:1px solid var(--rule);color:var(--ink-2);font-size:var(--fs-0);line-height:1.45}
  footer p{margin:.25rem 0;max-width:110ch}
